# Copy to .env and export these (or set them in your shell). Everything is optional.
# LLM_PROVIDER=anthropic          # anthropic | openai | none (none = offline rule-based planner)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / Groq / Gemini-compatible
# LLM_MODEL=
# COMPOSE_DIR=/path/to/DeathStarBench/hotelReservation
# LOAD_RPS=20
# NETEM_ENGINE=tc                 # tc | pumba
